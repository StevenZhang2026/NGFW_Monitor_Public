# NGFW Monitor 环境配置模板
# 复制为 .env 并修改后使用: cp env.example .env

# ============ 数据库 ============
POSTGRES_DB=ngfw_monitor
POSTGRES_USER=ngfw
POSTGRES_PASSWORD=请修改为强密码

# ============ 后端 ============
DATABASE_URL=postgresql+asyncpg://ngfw:请修改为强密码@db:5432/ngfw_monitor
SECRET_KEY=请修改为随机字符串_用openssl_rand_hex_32生成
ADMIN_INIT_PASSWORD=Admin@2024

# ============ Redis / Celery ============
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1

# ============ Web ============
WEB_PORT=443
CORS_ORIGINS=["https://localhost:443"]

# ============ 通知渠道（可选）============
# FEISHU_WEBHOOK_URL=https://open.feishu.cn/open-apis/bot/v2/hook/xxxxx
# WECHAT_WEBHOOK_URL=https://qyapi.weixin.qq.com/cgi-bin/webhook/send?key=xxxxx
# SMTP_HOST=smtp.example.com
# SMTP_PORT=465
# SMTP_USER=alert@example.com
# SMTP_PASSWORD=
# SMTP_FROM=alert@example.com
# SMTP_TO=admin@example.com
