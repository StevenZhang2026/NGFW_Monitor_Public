#!/usr/bin/env bash
# fix: 提交没带测试就提醒一句。
#
# 为什么是 commit-msg 而不是 pre-commit：pre-commit 跑的时候提交信息还没写，读不到
# "这是不是一个 fix"。commit-msg 收到的 $1 就是信息文件，同时 git diff --cached 还
# 是本次要提交的内容，两个都能看到。
#
# 为什么只提醒不拦截：合理的 fix 本来就有一大批测不了的（改 Dockerfile、调一个配置
# 值、只能在真机上验的采集口径）。拦下来的结果是养成 --no-verify 的手感，而
# --no-verify 是一刀切的 —— 它会连 pre-commit 的 gitleaks 一起关掉。为了一句提醒把
# 凭据门禁的实际生效率拉低，不值得。
set -uo pipefail

MSG_FILE=${1:?commit-msg hook 需要提交信息文件路径}

# 合并 / revert 提交的信息不是人写的，别拿它们判断。
if grep -qE '^(Merge|Revert)' "$MSG_FILE"; then
    exit 0
fi

# 只看首行，且只认 fix / fix(scope)。正文里出现 "fix" 不算。
SUBJECT=$(head -n 1 "$MSG_FILE")
if ! printf '%s' "$SUBJECT" | grep -qE '^fix(\([^)]*\))?!?:'; then
    exit 0
fi

STAGED=$(git diff --cached --name-only --diff-filter=ACMR)

# 只有动到有测试基建的源码目录才提醒。改 Dockerfile、compose、docs、yaml 配置的
# fix 没有对应的单测可写，提醒它们等于制造噪音。
if ! printf '%s\n' "$STAGED" | grep -qE '^(backend/app/|frontend/src/)'; then
    exit 0
fi

if printf '%s\n' "$STAGED" | grep -qE '(^backend/tests/|(^|/)test_[^/]+\.py$|\.test\.(ts|tsx|js|jsx)$)'; then
    exit 0
fi

echo "" >&2
echo "[提醒] 这是一条 fix，但本次提交没有动任何测试文件。" >&2
echo "  改完 bug 先问一句：能不能写一个「修之前会红」的用例？" >&2
echo "  能写就补上再 git commit --amend；确实写不了（只能真机验、改的是配置或" >&2
echo "  构建文件）就忽略这条，提交已经通过了。" >&2
echo "" >&2

# 提醒而已，永远放行。
exit 0
